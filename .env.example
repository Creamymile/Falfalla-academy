# Falfalla Academy - Environment Variables
# Copy this file to .env and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (required — used for password reset redirects)
VITE_SITE_URL=https://falfalla-academy.com

# Stripe (optional — payment not yet active)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
